{
  "expo": {
    "name": "Gridiron Connect",
    "slug": "gridiron-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gridiron",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1e3a5f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gridiron.connect"
    },
    "android": {
      "package": "com.gridiron.connect"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
